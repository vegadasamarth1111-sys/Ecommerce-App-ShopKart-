        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head><meta charset=\"UTF-8\"></head>\n<body style=\"font-family:'Segoe UI',sans-serif;background:#f4f4f4;margin:0;padding:0\">\n<div style=\"max-width:600px;margin:30px auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.1)\">\n  <div style=\"background:linear-gradient(135deg,#667eea,#764ba2);padding:40px;text-align:center;color:white\">\n    <h1 style=\"margin:0;font-size:28px\">Welcome to ShopEasy! 🎉</h1>\n    <p style=\"margin:12px 0 0;opacity:0.9\">Your account is ready</p>\n  </div>\n  <div style=\"padding:30px\">\n    <p>Hi <strong>{{ $json.body.first_name || $json.body.username }}</strong> 👋</p>\n    <p>We're thrilled to have you on board. Start exploring thousands of products at the best prices!</p>\n    <div style=\"background:#f8f9ff;border-radius:8px;padding:20px;margin:20px 0;text-align:center\">\n      <h3 style=\"color:#667eea;margin:0 0 8px\">🛍️ Ready to shop?</h3>\n      <p style=\"color:#666;margin:0\">Browse our latest collection and grab the best deals</p>\n      <a href=\"{{ $env.FRONTEND_URL }}\" style=\"display:inline-block;margin-top:16px;background:linear-gradient(135deg,#667eea,#764ba2);color:white;padding:12px 28px;border-radius:8px;text-decoration:none;font-weight:bold\">Shop Now →</a>\n    </div>\n    <p style=\"color:#666;font-size:14px\">If you didn't create this account, please ignore this email.</p>\n  </div>\n  <div style=\"background:#f8f9ff;padding:20px;text-align:center;color:#666;font-size:13px\">\n    <p>© 2025 ShopEasy · All rights reserved</p>\n  </div>\n</div>\n</body>\n</html>",
