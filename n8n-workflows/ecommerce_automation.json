{
  "name": "ECommerce Backend Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-placed",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-order-placed",
      "name": "🛒 Order Placed Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "order-placed-webhook"
    },
    {
      "parameters": {
        "jsCode": "// ─── Validate & Enrich Incoming Order Data ───\nconst body = $input.first().json.body || $input.first().json;\n\n// Required fields check\nconst required = ['order_id', 'user_email', 'user_name', 'total_amount', 'items'];\nconst missing = required.filter(f => !body[f]);\nif (missing.length > 0) {\n  throw new Error(`Missing required fields: ${missing.join(', ')}`);\n}\n\n// Build readable items list\nconst itemLines = (body.items || []).map(i =>\n  `• ${i.product_name} × ${i.quantity} — ₹${parseFloat(i.price_at_purchase).toFixed(2)}`\n).join('\\n');\n\nconst now = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });\n\nreturn [{\n  json: {\n    order_id:       body.order_id,\n    user_email:     body.user_email,\n    user_name:      body.user_name,\n    total_amount:   parseFloat(body.total_amount).toFixed(2),\n    status:         body.status || 'pending',\n    shipping_name:  body.shipping_full_name || body.user_name,\n    shipping_addr:  `${body.shipping_address}, ${body.shipping_city}, ${body.shipping_state} - ${body.shipping_pincode}`,\n    shipping_phone: body.shipping_phone || 'N/A',\n    items_text:     itemLines,\n    items_count:    (body.items || []).length,\n    placed_at:      now,\n    raw_items:      body.items || []\n  }\n}];"
      },
      "id": "validate-order",
      "name": "✅ Validate & Enrich Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-total",
              "leftValue": "={{ $json.total_amount }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-valid-order",
      "name": "🔍 Is Valid Order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "spreadsheet",
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Orders",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Order ID":       "={{ $json.order_id }}",
            "Customer Name":  "={{ $json.user_name }}",
            "Customer Email": "={{ $json.user_email }}",
            "Total (₹)":     "={{ $json.total_amount }}",
            "Status":         "={{ $json.status }}",
            "Items Count":    "={{ $json.items_count }}",
            "Shipping Address": "={{ $json.shipping_addr }}",
            "Phone":          "={{ $json.shipping_phone }}",
            "Placed At":      "={{ $json.placed_at }}"
          }
        },
        "options": {}
      },
      "id": "save-to-sheets",
      "name": "📊 Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [960, 180],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-cred",
          "name": "Google Sheets (OAuth2)"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SENDER_EMAIL }}",
        "toEmail": "={{ $json.user_email }}",
        "subject": "=✅ Order Confirmed! #{{ $json.order_id }} — Thank you {{ $json.user_name }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body { font-family: 'Segoe UI', sans-serif; background: #f4f4f4; margin: 0; padding: 0; }\n  .container { max-width: 600px; margin: 30px auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }\n  .header { background: linear-gradient(135deg, #667eea, #764ba2); padding: 30px; text-align: center; color: white; }\n  .header h1 { margin: 0; font-size: 24px; }\n  .body { padding: 30px; }\n  .order-box { background: #f8f9ff; border-left: 4px solid #667eea; padding: 16px; border-radius: 8px; margin: 20px 0; }\n  .items { width: 100%; border-collapse: collapse; margin-top: 16px; }\n  .items th { background: #667eea; color: white; padding: 10px; text-align: left; }\n  .items td { padding: 10px; border-bottom: 1px solid #eee; }\n  .total-row { font-weight: bold; font-size: 16px; }\n  .footer { background: #f8f9ff; padding: 20px; text-align: center; color: #666; font-size: 13px; }\n  .badge { display: inline-block; background: #22c55e; color: white; padding: 4px 12px; border-radius: 20px; font-size: 13px; }\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>🛍️ Order Confirmed!</h1>\n    <p style=\"margin:8px 0 0\">Your order has been received successfully</p>\n  </div>\n  <div class=\"body\">\n    <p>Hi <strong>{{ $json.user_name }}</strong> 👋</p>\n    <p>Thank you for your purchase! Here's your order summary:</p>\n    <div class=\"order-box\">\n      <p><strong>Order ID:</strong> #{{ $json.order_id }}</p>\n      <p><strong>Status:</strong> <span class=\"badge\">{{ $json.status }}</span></p>\n      <p><strong>Placed At:</strong> {{ $json.placed_at }}</p>\n      <p><strong>Shipping To:</strong> {{ $json.shipping_addr }}</p>\n      <p><strong>Phone:</strong> {{ $json.shipping_phone }}</p>\n    </div>\n    <h3>📦 Items Ordered</h3>\n    <pre style=\"background:#f8f9ff;padding:12px;border-radius:8px;font-size:14px\">{{ $json.items_text }}</pre>\n    <div style=\"text-align:right;margin-top:16px;font-size:18px;font-weight:bold;color:#667eea\">\n      Total: ₹{{ $json.total_amount }}\n    </div>\n    <hr style=\"margin:24px 0;border:none;border-top:1px solid #eee\">\n    <p style=\"color:#666;font-size:14px\">We'll notify you as soon as your order is shipped. If you have any questions, reply to this email.</p>\n  </div>\n  <div class=\"footer\">\n    <p>© 2025 ShopEasy · All rights reserved</p>\n    <p>You received this because you placed an order on our platform.</p>\n  </div>\n</div>\n</body>\n</html>",
        "options": {}
      },
      "id": "send-customer-email",
      "name": "📧 Email Customer",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, 320],
      "credentials": {
