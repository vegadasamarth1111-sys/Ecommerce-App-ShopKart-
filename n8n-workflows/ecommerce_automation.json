        "emailType": "html",
        "message": "=<div style=\"font-family:sans-serif;max-width:500px;margin:auto;padding:20px\">\n<h2 style=\"color:#f59e0b\">⚠️ Low Stock Alert</h2>\n<p>The following product is running low on inventory:</p>\n<table style=\"width:100%;border-collapse:collapse\">\n  <tr><td style=\"padding:8px;font-weight:bold\">Product</td><td>{{ $json.body.product_name }}</td></tr>\n  <tr style=\"background:#fef3c7\"><td style=\"padding:8px;font-weight:bold\">Stock Left</td><td style=\"color:#dc2626;font-weight:bold\">{{ $json.body.stock_qty }} units</td></tr>\n  <tr><td style=\"padding:8px;font-weight:bold\">Product ID</td><td>{{ $json.body.product_id }}</td></tr>\n  <tr style=\"background:#fef3c7\"><td style=\"padding:8px;font-weight:bold\">Category</td><td>{{ $json.body.category }}</td></tr>\n  <tr><td style=\"padding:8px;font-weight:bold\">Price</td><td>₹{{ $json.body.price }}</td></tr>\n</table>\n<p style=\"color:#666;font-size:13px;margin-top:20px\">Please restock soon to avoid losing sales.</p>\n</div>",
