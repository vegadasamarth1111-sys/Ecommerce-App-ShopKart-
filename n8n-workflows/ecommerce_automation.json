    {
      "parameters": {
        "jsCode": "// ─── Log success ───\nconst order = $('✅ Validate & Enrich Order').first().json;\nconsole.log(`[SUCCESS] Order #${order.order_id} processed at ${new Date().toISOString()}`);\n\nreturn [{\n  json: {\n    success: true,\n    message: `Order #${order.order_id} fully processed`,\n    order_id: order.order_id,\n    steps_completed: ['google_sheets', 'customer_email', 'admin_email', 'status_update'],\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "success-log",
      "name": "✅ Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 390]
    },
    {
      "parameters": {
        "jsCode": "// ─── Error handler — runs when order validation fails ───\nconst errMsg = $input.first().json.error || 'Invalid order data';\nconsole.error(`[ERROR] Invalid order rejected: ${errMsg}`);\n\nreturn [{\n  json: {\n    success: false,\n    error: errMsg,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "invalid-order-log",
      "name": "❌ Invalid Order Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 740]
