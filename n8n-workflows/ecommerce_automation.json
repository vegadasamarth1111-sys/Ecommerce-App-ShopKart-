        "fromEmail": "={{ $env.SENDER_EMAIL }}",
        "toEmail": "={{ $env.ADMIN_EMAIL }}",
        "subject": "=🔔 New Order #{{ $json.order_id }} — ₹{{ $json.total_amount }} from {{ $json.user_name }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:sans-serif;max-width:500px;margin:auto;padding:20px\">\n<h2 style=\"color:#667eea\">🛒 New Order Alert</h2>\n<table style=\"width:100%;border-collapse:collapse\">\n  <tr><td style=\"padding:8px;font-weight:bold\">Order ID</td><td>#{{ $json.order_id }}</td></tr>\n  <tr style=\"background:#f8f9ff\"><td style=\"padding:8px;font-weight:bold\">Customer</td><td>{{ $json.user_name }}</td></tr>\n  <tr><td style=\"padding:8px;font-weight:bold\">Email</td><td>{{ $json.user_email }}</td></tr>\n  <tr style=\"background:#f8f9ff\"><td style=\"padding:8px;font-weight:bold\">Phone</td><td>{{ $json.shipping_phone }}</td></tr>\n  <tr><td style=\"padding:8px;font-weight:bold\">Total</td><td style=\"color:#22c55e;font-weight:bold\">₹{{ $json.total_amount }}</td></tr>\n  <tr style=\"background:#f8f9ff\"><td style=\"padding:8px;font-weight:bold\">Items</td><td>{{ $json.items_count }} items</td></tr>\n  <tr><td style=\"padding:8px;font-weight:bold\">Shipping</td><td>{{ $json.shipping_addr }}</td></tr>\n  <tr style=\"background:#f8f9ff\"><td style=\"padding:8px;font-weight:bold\">Placed At</td><td>{{ $json.placed_at }}</td></tr>\n</table>\n<pre style=\"background:#f4f4f4;padding:12px;border-radius:8px;margin-top:16px\">{{ $json.items_text }}</pre>\n<p style=\"color:#666;font-size:13px;margin-top:20px\">Login to admin panel to process this order.</p>\n</div>",
        "options": {}
      },
      "id": "notify-admin-email",
      "name": "📨 Notify Admin",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, 460],
      "credentials": {
        "smtp": {
          "id": "smtp-cred",
          "name": "SMTP (Gmail)"
        }
      }
